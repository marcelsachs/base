#!/usr/bin/env bash
# hw - probes and boards on this machine. Two USB ST-LINKs, one NVIDIA GPU.
#
#   hw [ls]                     probes, boards, VCP ttys, GPU
#   hw probes                   ST-LINK serials under /dev/stlink
#   hw serial NAME              probe serial of board NAME ($HW_BOARDS)
#   hw tty NAME                 VCP tty of board NAME
#   hw gpu                      nvidia-smi summary
set -uo pipefail
: "${HW_BOARDS:=/etc/n6/boards}"
die() { printf 'hw: %s\n' "$*" >&2; exit 2; }

row() { awk -v n="$1" '$1==n && $1!~/^#/ {print; f=1} END{exit !f}' "$HW_BOARDS" || die "unknown board '$1' (see $HW_BOARDS)"; }
serial() { local s; s=$(row "$1" | awk '{print $2}'); [[ $s == - ]] && s=; printf '%s\n' "$s"; }
tty_of() {
  local s; s=$(serial "$1")
  if [[ -n $s && -e /dev/tty-stlink/$s ]]; then readlink -f "/dev/tty-stlink/$s"; else ls /dev/ttyACM* 2>/dev/null | head -1; fi
}
probes() {
  local p found=0
  for p in /dev/stlink/*; do
    [[ -e $p ]] || continue
    found=1
    printf '%s\n' "${p##*/}"
  done
  (( found )) || { echo "none under /dev/stlink" >&2; return 1; }
}
gpu() {
  [[ -e /dev/nvidia0 ]] || { echo "GPU: /dev/nvidia0 not visible (sandbox?) - run unsandboxed"; return 1; }
  nvidia-smi --query-gpu=name,driver_version,memory.used,memory.total,utilization.gpu,temperature.gpu --format=csv,noheader
}
ls_all() {
  echo "probes:"
  local p found=0
  for p in /dev/stlink/*; do
    [[ -e $p ]] || continue
    found=1
    printf '  %s' "${p##*/}"
    [[ -e /dev/tty-stlink/${p##*/} ]] && printf '  tty=%s' "$(readlink -f "/dev/tty-stlink/${p##*/}")"
    echo
  done
  (( found )) || echo "  none under /dev/stlink"
  echo "boards ($HW_BOARDS):"
  while read -r n s c x; do
    [[ -z $n || $n == \#* ]] && continue
    st=absent; [[ $s == - ]] && st=any-probe; [[ $s != - && -e /dev/stlink/$s ]] && st=present
    printf '  %-11s %-26s %-10s %-18s %s\n' "$n" "$s" "$c" "${x:-SWD}" "$st"
  done <"$HW_BOARDS"
  echo "gpu:"; printf '  %s\n' "$(gpu 2>&1)"
}

case ${1-ls} in
  ls)      ls_all ;;
  probes)  probes ;;
  serial)  serial "${2:?NAME}" ;;
  tty)     tty_of "${2:?NAME}" ;;
  gpu)     gpu ;;
  *)       sed -n '2,/^set -/p' "$0" | sed 's/^# \{0,1\}//;$d'; exit 1 ;;
esac
