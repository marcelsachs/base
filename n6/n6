#!/usr/bin/env bash
# n6 - STM32N6 load / debug. OpenOCD + gdb.
# Never reset a running AXISRAM image: reset re-runs the boot ROM and wipes RAM.
#
#   n6 [-b BOARD] info | load ELF | mon | gdb [-l] ELF | check
# BOARD: plugged ST-LINK. -b / $N6_BOARD / cwd if both are in.
set -euo pipefail
N6_SHARE=${N6_SHARE:-/etc/n6}
GDBDIR=$N6_SHARE/gdb
export HW_BOARDS=${HW_BOARDS:-$N6_SHARE/boards}

die() { printf 'n6: %s\n' "$*" >&2; exit 2; }

present_boards() {
  local n s c x
  while read -r n s c x; do
    [[ -z ${n-} || $n == \#* || $n == *-dfu ]] && continue
    [[ $s != - && -e /dev/stlink/$s ]] && printf '%s\n' "$n"
  done <"$HW_BOARDS"
}

pick_board() {
  local b= present
  mapfile -t present < <(present_boards)
  [[ ${#present[@]} -eq 1 ]] && { printf '%s\n' "${present[0]}"; return; }
  [[ -n ${N6_BOARD-} ]] && { printf '%s\n' "$N6_BOARD"; return; }
  case $PWD in
    /drone|/drone/*) b=openmv ;;
    /sentry|/sentry/*) b=nucleo ;;
  esac
  [[ -n $b ]] && { printf '%s\n' "$b"; return; }
  [[ ${#present[@]} -gt 1 ]] && die "both ST-LINKs plugged. -b openmv | nucleo"
  die "no ST-LINK. plug OpenMV MiniE or Nucleo CN10"
}

pick_gdb() {
  local g
  if [[ -n ${GDB-} ]]; then
    command -v "$GDB" || die "GDB=$GDB not found"
    return
  fi
  for g in gdb arm-none-eabi-gdb; do
    command -v "$g" >/dev/null || continue
    if "$g" --batch -ex 'python print("pyok")' -ex quit 2>/dev/null | grep -q pyok; then
      command -v "$g"
      return
    fi
  done
  die "no gdb with python"
}

n6_check() {
  local fail=0 g tmp p found=0
  need() {
    if command -v "$1" >/dev/null; then
      printf 'ok   %s  %s\n' "$1" "$("$1" --version 2>/dev/null | head -1)"
    else
      printf 'MISS %s\n' "$1"
      fail=1
    fi
  }
  need arm-none-eabi-gcc
  need arm-none-eabi-objdump
  need arm-none-eabi-size
  need openocd
  need picocom
  need make
  tmp=$(mktemp /tmp/n6-cc-XXXXXX.o)
  if arm-none-eabi-gcc -mcpu=cortex-m55 -mthumb -c -x c /dev/null -o "$tmp" 2>/dev/null; then
    printf 'ok   gcc -mcpu=cortex-m55\n'
  else
    printf 'MISS gcc cortex-m55\n'
    fail=1
  fi
  rm -f "$tmp"
  if g=$(pick_gdb 2>/dev/null); then
    printf 'ok   gdb python  %s\n' "$g"
  else
    printf 'MISS gdb python\n'
    fail=1
  fi
  tmp=$(mktemp /tmp/n6-ocd-XXXXXX.txt)
  openocd -c "echo [find target/stm32n6x.cfg]" -c shutdown >"$tmp" 2>&1 || true
  if grep -q stm32n6x "$tmp"; then
    printf 'ok   openocd stm32n6x.cfg\n'
  else
    printf 'MISS openocd stm32n6x.cfg\n'
    tail -5 "$tmp"
    fail=1
  fi
  rm -f "$tmp"
  for p in /dev/stlink/*; do
    [[ -e $p ]] || continue
    found=1
    break
  done
  if (( found )); then
    printf 'ok   probe\n'
  else
    printf 'MISS probe  /dev/stlink\n'
    fail=1
  fi
  return "$fail"
}

gdb_run() {
  local load=$1 dash=$2 elf=$3
  shift 3
  [[ -f $elf ]] || die "no file $elf"
  local gdb sn ocd args
  gdb=$(pick_gdb)
  sn=$(hw serial "$BOARD")
  [[ -n $sn ]] || die "no serial for $BOARD"
  openocd -f interface/stlink.cfg -c "adapter serial $sn" -f target/stm32n6x.cfg \
    -c 'gdb_port 3333' -c 'tcl_port 6666' -c 'telnet_port 4444' >/dev/null 2>&1 &
  ocd=$!
  trap 'kill $ocd 2>/dev/null' EXIT
  sleep 0.5
  kill -0 "$ocd" 2>/dev/null || die "openocd failed"
  args=( -q )
  (( dash )) && [[ -f $GDBDIR/dashboard.gdbinit ]] && args+=( -x "$GDBDIR/dashboard.gdbinit" )
  [[ -f $GDBDIR/n6.gdb ]] && args+=( -x "$GDBDIR/n6.gdb" )
  args+=( -ex 'target extended-remote :3333' -ex 'monitor halt' )
  (( load )) && args+=( -ex 'n6-load' )
  "$gdb" "${args[@]}" "$@" "$elf"
}

BOARD=
ARGS=()
while [[ $# -gt 0 ]]; do
  case $1 in
    -b) BOARD=${2:?BOARD}; shift 2 ;;
    *) ARGS+=("$1"); shift ;;
  esac
done
set -- "${ARGS[@]}"
cmd=${1:-}; shift || true
[[ -n $cmd ]] || { sed -n '/^# n6 /,/^set -/p' "$0" | sed 's/^# \{0,1\}//;/^set /d'; exit 1; }

if [[ $cmd == check ]]; then
  n6_check
  exit
fi

[[ -z $BOARD ]] && BOARD=$(pick_board)
export N6_BOARD=$BOARD

case $cmd in
  info)
    hw ls
    echo
    echo "board $BOARD  serial=$(hw serial "$BOARD")  tty=$(hw tty "$BOARD" 2>/dev/null || echo none)"
    ;;
  load)
    gdb_run 1 0 "${1:?ELF}" --batch -ex quit
    ;;
  mon)
    tty=$(hw tty "$BOARD") || die "no VCP for $BOARD"
    exec picocom -q -b 115200 "$tty"
    ;;
  gdb)
    load=0
    [[ ${1-} == -l ]] && { load=1; shift; }
    gdb_run "$load" 1 "${1:?ELF}"
    ;;
  *) die "unknown command $cmd" ;;
esac
